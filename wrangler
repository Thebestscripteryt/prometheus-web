{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prometheus-obfuscator",
  "main": "worker.js",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ALLOWED_ORIGIN": "*"
  },
  "observability": {
    "enabled": true
  }
}
